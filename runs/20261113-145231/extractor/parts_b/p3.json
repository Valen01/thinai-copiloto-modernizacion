{
"rule_id": "R-018", "tipo": "negocio", "categoria": "calculo",
"descripcion": "Conteo de siniestralidad: cuenta siniestros de la MISMA póliza, distintos del actual, en estado LIQUIDADO (no cuentan PENDIENTE_REVISION ni RECHAZADO), con ocurrencia >= (ocurrencia actual - 365 días) y < ocurrencia actual. Se basa en el estado del siniestro al momento, por lo que los liquidados antes dentro del mismo lote cuentan (el orden por id importa).",
"condicion": "siempre, tras calcular el cubierto",
"accion": "v_cant_siniestros := COUNT(*)",
"parametros": {"ventana_dias": 365, "limite_inferior": ">= inclusive", "limite_superior": "< exclusive", "estado_contado": "LIQUIDADO"},
"evidencia": [
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "AND s.siniestro_id     <> v_sin.siniestro_id"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "AND s.estado            = c_sin_liquidado"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "AND s.fecha_ocurrencia >= v_sin.fecha_ocurrencia - 365"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "AND s.fecha_ocurrencia <  v_sin.fecha_ocurrencia;"}
],
"confianza": "alta", "preguntas_abiertas": ["¿Deben contar también los PENDIENTE_REVISION?"], "estado_revision": "pendiente"
},
{
"rule_id": "R-019", "tipo": "negocio", "categoria": "calculo",
"descripcion": "Penalización por siniestralidad: si la cantidad contada es >= MAX_SINIESTROS_ANUAL (3), el cubierto se reduce PCT_PENALIZACION_SINIEST (10) %: ROUND(cubierto * 90 / 100, 2), con marca PENALIZACION_SINIESTRALIDAD. Se aplica antes del tope de suma asegurada y de la retención.",
"condicion": "conteo >= 3",
"accion": "cubierto := ROUND(cubierto * (100 - 10) / 100, 2)",
"parametros": {"max_siniestros": 3, "pct_penalizacion": 10, "operador": ">="},
"evidencia": [
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "IF v_cant_siniestros >= fn_param_num('MAX_SINIESTROS_ANUAL') THEN"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "v_cubierto := ROUND(v_cubierto * (100 - fn_param_num('PCT_PENALIZACION_SINIEST')) / 100, 2);"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "pr_agregar_obs(v_observaciones, 'PENALIZACION_SINIESTRALIDAD');"},
{"archivo": "02_parametros.sql", "fragmento": "('MAX_SINIESTROS_ANUAL', 3,"},
{"archivo": "02_parametros.sql", "fragmento": "('PCT_PENALIZACION_SINIEST', 10,"}
],
