{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "AND v_cubierto > fn_param_num('UMBRAL_RETENCION')"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "v_retencion := ROUND(v_cubierto * fn_param_num('TASA_RETENCION') / 100, 2);"},
{"archivo": "04_pkg_liquidacion_siniestros_body.sql", "fragmento": "pr_agregar_obs(v_observaciones, 'RETENCION_APLICADA');"},
