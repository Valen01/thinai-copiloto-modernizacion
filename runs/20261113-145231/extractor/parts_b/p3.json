{
"rule_id": "R-022", "tipo": "negocio", "categoria": "calculo",
"descripcion": "Retención impositiva: si el ramo no es VIDA y el cubierto final (tras penalización y tope) es estrictamente mayor a UMBRAL_RETENCION (10000), retención = ROUND(cubierto * TASA_RETENCION(2) / 100, 2) y marca RETENCION_APLICADA; si no, retención 0. Con cubierto exactamente 10000 no se retiene. VIDA nunca retiene.",
"condicion": "ramo <> 'VIDA' AND cubierto > 10000",
"accion": "v_retencion calculada o 0",
"parametros": {"umbral": 10000, "tasa_pct": 2, "operador": ">", "ramo_excluido": "VIDA"},
"evidencia": [
